{
  "name": "tsdm-sdk-build",
  "private": true,
  "type": "module",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "build:sdk": "vite build --config vite.sdk.config.ts && tsc --project tsconfig.sdk.json && node scripts/stage-sdk.mjs",
    "pack:sdk": "npm run build:sdk && npm pack --offline --ignore-scripts ./dist/sdk --pack-destination ./dist",
    "test:install": "node scripts/check-installed-sdk.mjs dist/tsdm-sdk-0.1.0.tgz",
    "test:rehearsal": "node tests/rehearsal/rehearse.mjs"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "entities": "8.1.0",
    "parse5": "8.0.1",
    "typescript": "6.0.3",
    "vite": "8.3.4"
  }
}
